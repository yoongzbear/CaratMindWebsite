    "exc_desc": {
      "S": "A breathing technique that uses deep inhalation focusing on the inhaling with maximum diaphragm movement. It increases sustained attention and reduces stress."
    },
    "exc_steps": {
      "L": [
        {
          "S": "Sit comfortably with your shoulders, head and neck relaxed."
        },
        {
          "S": "Place one hand on your upper chest and the other just below your rib cage to feel your diaphragm move as you breathe."
        },
        {
          "S": "Breathe in slowly through your nose so that your stomach moves out against your hand. The hand on your chest should remain as still as possible."
        },
        {
          "S": "Tighten your stomach muscles, so that your stomach moves back in, as you breathe out through pursed lips. The hand on your upper chest must remain as still as possible."
        },
        {
          "S": "Repeat for 5 to 10 minutes."
        }
      ]
    }
