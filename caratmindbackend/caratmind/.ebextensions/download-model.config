container_commands:
    01_create_model_dir:
        command: "mkdir -p /var/app/current/models"
    02_download_model:
        command: "aws s3 cp s3://caratmind-assets/models/qwen2.5-1.5b-instruct-q4_k_m.gguf /var/app/current/models/qwen2.5-1.5b-instruct-q4_k_m.gguf --region ap-southeast-5"
        ignoreErrors: false