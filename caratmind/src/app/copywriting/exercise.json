    "exc_desc": {
      "S": "A breathing technique to help calm the body by focusing on slow, controlled breathing that relaxes muscles and reduces tension. Practicing it every 1 to 2 hours can improve focus and ease stress."
    },
    "exc_steps": {
      "L": [
        {
          "S": "Stay in a relaxed state and drop your shoulders."
        },
        {
          "S": "Breathe in through your nose and inflate your stomach in 4 to 5 seconds."
        },
        {
          "S": "Breathe out in 4 to 5 seconds through your nose or mouth and deflate your stomach."
        },
        {
          "S": "Repeat 5 times in a set."
        }
      ]
    }
  },
