files:
  "/etc/cron.d/notifications":
    mode: "000644"
    owner: root
    group: root
    content: |
      0 12 * * * root source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py daily_notification >> /var/log/notifications.log 2>&1
      59 15 * * * root source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py close_incomplete_exercise >> /var/log/exercise_closeout.log 2>&1